# Portaldot RPC — flip between local devnet and live mainnet with this one var
PORTALDOT_RPC_URL=wss://mainnet.portaldot.io
# PORTALDOT_RPC_URL=ws://127.0.0.1:9944

# Headless wallet (MCP-client context). Auto-generated on first run if unset;
# persisted to ~/.portaldot-mcp/config.json. NEVER commit a real seed.
PORTALDOT_SEED_PHRASE=

# Deployed ink! Task Ledger contract (filled after deploy)
TASK_LEDGER_CONTRACT_ADDRESS=

# AI (web app chat) — set ANY one provider key. Auto-detected; override with
# AI_MODEL="provider:model" (openai:gpt-5, anthropic:claude-sonnet-4-6, xai:grok-4, google:gemini-2.5-pro).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# AI_MODEL=
