{
  "name": "portaldot-mcp-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "The first MCP server for Portaldot — natural-language onchain execution + generative-UI web app.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "dev:mcp": "pnpm --filter @portaldot-mcp/mcp dev",
    "dev:web": "pnpm --filter @portaldot-mcp/web dev",
    "green": "bash .claude/scripts/green-light.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
